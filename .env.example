# Copia este archivo a ".env" (o exporta estas variables en tu shell /
# en la configuracion de despliegue de tu servidor) y completa los
# valores reales. Nunca subas el ".env" real al repositorio: solo este
# ejemplo, sin credenciales, debe quedar versionado.
#
# El backend las lee con System.getenv().getOrDefault(...), asi que si
# una variable no esta definida se usa el valor por defecto indicado
# entre parentesis en cada seccion (pensado para desarrollo local).

# --- Base de datos (ver ConexionBD) ---
DB_URL=jdbc:mysql://localhost:3306/cafe_don_bosco
DB_USUARIO=root
DB_PASSWORD=

# --- Correo saliente para el envio del ticket en PDF (ver EmailServiceImpl) ---
# Si SMTP_HOST se deja vacio, el envio de correos se omite (se registra
# en el log) en vez de fallar la operacion que lo disparo.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=no-responder@cafedonbosco.com

# --- Logging (ver logback.xml) ---
# LOG_DIR por defecto usa <catalina.base>/logs cuando corre desplegado
# en Tomcat, o ./logs si corre fuera de un contenedor (por ejemplo, al
# ejecutar las pruebas).
LOG_DIR=
LOG_NIVEL=INFO
